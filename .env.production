# Dibaca otomatis oleh `vite build`. Versi web (Vercel) tidak punya server Node -> aplikasi memanggil AI langsung dari browser
# memakai API key yang diisi pengguna di Pengaturan (kunci TIDAK pernah masuk ke kode/situs).
VITE_STANDALONE=true
# ID Google Analytics (opsional di sini; atau isi langsung di src/lib/analytics.ts):
# VITE_GA_ID=G-XXXXXXXXXX
